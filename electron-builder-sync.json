{
  "appId": "io.github.p3n1cillin.drawio-desktop-sync",
  "productName": "drawio-desktop-sync",
  "copyright": "Copyright 2017-2026 draw.io Ltd",
  "asar": true,
  "npmRebuild": false,
  "afterPack": "build/fuses.mjs",
  "artifactName": "drawio-desktop-sync-${version}-${arch}.${ext}",
  "directories": {
    "output": "./dist/sync"
  },
  "files": [
    "**/*",
    "!**/WEB-INF{,/**}",
    "!drawio/src/main/webapp/stencils/**/*.xml",
    "!drawio/src/main/webapp/shapes{,/**}",
    "!drawio/src/main/webapp/js/diagramly{,/**}",
    "drawio/src/main/webapp/js/diagramly/{ElectronApp,DesktopLibrary}.js",
    "!drawio/src/main/webapp/js/grapheditor{,/**}",
    "!drawio/src/main/webapp/mxgraph/src{,/**}",
    "!drawio/src/main/webapp/mxgraph/mxClient.js",
    "!node_modules/@cantoo/pdf-lib/{cjs,dist,src,ts3.4}{,/**}",
    "!**/*.map",
    "!dist{,/**}",
    "!src/test{,/**}",
    "!build/test-sync-installer.ps1",
    "!doc{,/**}",
    "!drawio/.git{,/**}"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "signAndEditExecutable": true,
    "signExecutable": false
  },
  "nsis": {
    "artifactName": "drawio-desktop-sync-${version}-${arch}-setup.${ext}",
    "include": "build/sync-installer.nsh",
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "packElevateHelper": false,
    "allowToChangeInstallationDirectory": true,
    "runAfterFinish": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "drawio-desktop-sync",
    "deleteAppDataOnUninstall": false
  },
  "fileAssociations": []
}
